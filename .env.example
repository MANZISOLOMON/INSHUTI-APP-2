# ==============================================================================
# LOST & FOUND REGISTRY - ENVIRONMENT VARIABLES CHECKLIST
# Copy this file to .env.local for local development or set in Vercel Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE WEB CONFIGURATION (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lost-it-found-it-se6la.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lost-it-found-it-se6la
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lost-it-found-it-se6la.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK SERVICE ACCOUNT (Private)
# Generate from Firebase Console -> Project Settings -> Service Accounts
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=lost-it-found-it-se6la
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lost-it-found-it-se6la.iam.gserviceaccount.com
# Note: Escape newlines as \n or enclose in quotes if deploying to Vercel
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. MOBILE MONEY (MTN MoMo & Airtel Money) GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
MOMO_API_KEY=momo_api_key_xxxxxxxxxxxxxxxx
MOMO_SUBSCRIPTION_KEY=momo_sub_key_xxxxxxxxxxxxxxxx
MOMO_API_USER=momo_user_uuid
# Set to 'sandbox' for test simulation, or 'production' for live disbursements
MOMO_TARGET_ENV=sandbox

# ------------------------------------------------------------------------------
# 4. CELLULAR SMS GATEWAY (Africa's Talking / Local Gateway)
# ------------------------------------------------------------------------------
SMS_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_USERNAME=sandbox

# ------------------------------------------------------------------------------
# 5. ADMIN & LIFECYCLE CRON SECURITY SECRETS
# ------------------------------------------------------------------------------
# Protected Passkey for accessing /admin moderation dashboard and override actions
ADMIN_SECRET_KEY=rwanda-admin-secure-2026

# Protected Secret header for /api/cron/lifecycle 6-hour automated sweeps
CRON_SECRET=rwanda-cron-secret-2026
